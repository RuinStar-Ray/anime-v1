# Anime Fortress configuration
# Copy to .env and fill in the required values. Never commit .env.

# --- Core ---------------------------------------------------------------
APP_NAME=Anime Fortress
APP_ENV=production
DATA_DIR=./data
# Leave empty for SQLite at DATA_DIR/anime.db. For PostgreSQL install the
# "postgres" extra and use, for example:
# DATABASE_URL=postgresql+asyncpg://anime:change-me@postgres:5432/anime
DATABASE_URL=

# --- Telegram -----------------------------------------------------------
# Required. Create the bot with @BotFather and add it to the destination
# channel as an administrator with post permission.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the admin bot.
ADMIN_USER_IDS=
# Optional Telegram Bot API-compatible base URL (for local Bot API servers).
TELEGRAM_API_BASE_URL=
DEFAULT_CHANNEL_ID=
DEFAULT_BRANDING=@YourChannel

# --- Storage ------------------------------------------------------------
# Empty values default to subdirectories of DATA_DIR.
TEMP_DIR=
MEDIA_DIR=
POSTERS_DIR=
THUMBNAILS_DIR=
# OS path separator list: ";" on Windows, ":" on POSIX. Local library sources
# are rejected unless their root is inside this allowlist.
MEDIA_LIBRARY_ROOTS=

# --- FFmpeg -------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Audio and quality --------------------------------------------------
PREFERRED_LANGUAGES=Hindi,English,Japanese,Tamil,Telugu,French
INCLUDE_EXTRA_AUDIO=true
INCLUDE_UNKNOWN_AUDIO=true
INCLUDE_SUBTITLES=true
PREFERRED_QUALITIES=480p,720p,1080p
INCLUDE_OTHER_QUALITIES=false
ALLOW_SILENT_VIDEO=false
AUDIO_LABEL_STYLE=multi
DUAL_AUDIO_LABEL=Dual
MULTI_AUDIO_LABEL=Multi Audio

# --- Metadata -----------------------------------------------------------
METADATA_PROVIDERS=jikan,anilist

# --- Naming and templates ----------------------------------------------
FILENAME_PATTERN=[S{season:02d}-Ep{episode:02d}] {anime_title} [{quality}] [{audio_label}] {branding}.mkv
CAPTION_TEMPLATE={file_name}
MISSING_VALUE_TEXT=N/A
CLEANUP_BLANK_LINES=true
MAX_CAPTION_LENGTH=1024
MAX_MESSAGE_LENGTH=4096
MAX_DOCUMENT_FILENAME_LENGTH=120

# --- Publishing rules ---------------------------------------------------
STRICT_EPISODE_ORDER=true
REQUIRE_ANNOUNCEMENT=true

# --- Limits and network -------------------------------------------------
# Keep below the active Telegram Bot API upload limit (49 MB is safe).
MAX_UPLOAD_MB=49
MAX_DOWNLOAD_MB=4096
HTTP_TIMEOUT_SECONDS=30
# Only enable for sources you control on a private network.
ALLOW_PRIVATE_NETWORKS=false
USER_AGENT=AnimeFortress/0.1 (+https://github.com/RuinStar-Ray/anime-v1)

# --- Worker and retries -------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_SECONDS=900
TASK_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=3600
CLEANUP_TEMP_FILES=true
TEMP_RETENTION_HOURS=24

# --- Logging ------------------------------------------------------------
TIMEZONE=UTC
LOG_LEVEL=INFO
LOG_JSON=false
REDACT_SECRETS_IN_LOGS=true

# --- Per-source credentials --------------------------------------------
# Referenced by name from a source's "headers_env" config. Put the actual
# header JSON here, not in the source config stored in the database.
# ANIME_SOURCE_HEADERS={"Authorization":"Bearer change-me"}
